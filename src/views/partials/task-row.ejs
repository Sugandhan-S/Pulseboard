<%
const statusLabels = { todo: 'To Do', in_progress: 'In Progress', review: 'Review', done: 'Done' };
const priorityLabels = { low: 'Low', medium: 'Medium', high: 'High' };
const today = new Date().toISOString().split('T')[0];
const isDone = task.status === 'done' || task.is_completed;

let dueClass = '';
if (task.due_date && !isDone) {
  if (task.due_date < today) dueClass = 'overdue';
  else if (task.due_date === today) dueClass = 'due-soon';
}
%>
<li
  id="task-<%= task.id %>"
  class="task-row htmx-added <%= isDone ? 'is-done' : '' %>"
>
  <!-- Status Checkbox (PATCH /tasks/:id/status) -->
  <div class="task-checkbox-wrap">
    <input
      type="checkbox"
      class="task-checkbox"
      id="check-<%= task.id %>"
      <%= isDone ? 'checked' : '' %>
      hx-patch="/tasks/<%= task.id %>/status"
      hx-vals='{"status": "<%= isDone ? "todo" : "done" %>"}'
      hx-target="#task-<%= task.id %>"
      hx-swap="outerHTML"
      hx-indicator="#global-loader"
    />
  </div>

  <!-- Body -->
  <div class="task-body">
    <div class="task-title"><%= task.title %></div>
    <div class="task-meta">
      <!-- Status Dropdown (PATCH inline) -->
      <select
        class="task-status-select"
        data-status="<%= task.status %>"
        hx-patch="/tasks/<%= task.id %>/status"
        hx-target="#task-<%= task.id %>"
        hx-swap="outerHTML"
        hx-indicator="#global-loader"
        name="status"
        hx-include="this"
      >
        <option value="todo" <%= task.status === 'todo' ? 'selected' : '' %>>To Do</option>
        <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
        <option value="review" <%= task.status === 'review' ? 'selected' : '' %>>Review</option>
        <option value="done" <%= task.status === 'done' ? 'selected' : '' %>>Done</option>
      </select>

      <!-- Priority Badge -->
      <span class="badge badge-<%= task.priority %>">
        <%= task.priority === 'high' ? '🔴' : task.priority === 'medium' ? '🟡' : '🟢' %>
        <%= priorityLabels[task.priority] %>
      </span>

      <!-- Project Link -->
      <% if (task.project_name) { %>
        <a href="/projects/<%= task.project_id %>" class="task-project-link">📁 <%= task.project_name %></a>
      <% } %>

      <!-- Due Date -->
      <% if (task.due_date) { %>
        <span class="task-due <%= dueClass %>">
          📅 <%= dueClass === 'overdue' ? '⚠️ ' : '' %><%= task.due_date %>
        </span>
      <% } %>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="task-actions">
    <button
      class="task-action-btn"
      data-tooltip="Edit task"
      hx-get="/tasks/<%= task.id %>/edit"
      hx-target="#task-<%= task.id %>"
      hx-swap="outerHTML"
      hx-indicator="#global-loader"
    >✏️</button>
    <button
      class="task-action-btn danger"
      data-tooltip="Delete task"
      hx-delete="/tasks/<%= task.id %>"
      hx-confirm="Delete this task? This cannot be undone."
      hx-target="#task-<%= task.id %>"
      hx-swap="outerHTML swap:0.1s"
      hx-indicator="#global-loader"
    >🗑️</button>
  </div>
</li>
