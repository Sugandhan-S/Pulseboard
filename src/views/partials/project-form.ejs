<%
const f = (typeof formData !== 'undefined' && formData) ? formData : (project || {});
const isEdit = project && project.id;
%>
<div class="form-overlay" id="project-form-overlay">
  <div class="form-panel" role="dialog" aria-modal="true" aria-label="<%= isEdit ? 'Edit Project' : 'New Project' %>">
    <div class="form-panel-header">
      <h2 class="form-panel-title"><%= isEdit ? '✏️ Edit Project' : '📁 New Project' %></h2>
      <button
        class="form-close-btn"
        onclick="document.getElementById('modal-container').innerHTML=''"
        type="button"
      >✕</button>
    </div>

    <form
      <% if (isEdit) { %>
        hx-put="/projects/<%= project.id %>"
      <% } else { %>
        hx-post="/projects"
      <% } %>
      hx-indicator="#global-loader"
    >
      <div class="form-body">

        <!-- Inline Errors -->
        <% if (errors && errors.length > 0) { %>
          <ul class="error-list">
            <% errors.forEach(e => { %>
              <li>⚠️ <%= e %></li>
            <% }) %>
          </ul>
        <% } %>

        <div class="form-group">
          <label class="form-label" for="proj-name">Project Name <span class="required">*</span></label>
          <input
            id="proj-name"
            name="name"
            type="text"
            class="form-input <%= errors && errors.length ? 'error' : '' %>"
            placeholder="e.g. Website Redesign"
            value="<%= f.name || '' %>"
            required
            maxlength="80"
            autofocus
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="proj-desc">Description</label>
          <textarea
            id="proj-desc"
            name="description"
            class="form-input form-textarea"
            placeholder="What is this project about?"
            rows="3"
          ><%= f.description || '' %></textarea>
        </div>

      </div>

      <div class="form-footer">
        <button
          type="button"
          class="btn btn-ghost"
          onclick="document.getElementById('modal-container').innerHTML=''"
        >Cancel</button>
        <button type="submit" class="btn btn-primary">
          <%= isEdit ? '💾 Save Changes' : '📁 Create Project' %>
        </button>
      </div>
    </form>
  </div>
</div>
