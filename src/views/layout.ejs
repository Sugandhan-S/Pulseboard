<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ? title + ' — PulseBoard' : 'PulseBoard' %></title>
  <meta name="description" content="PulseBoard — A lightweight team task and activity board. Manage projects, tasks, and track your team's progress." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://unpkg.com/htmx.org@1.9.12" defer></script>
</head>
<body hx-boost="false">
  <div id="htmx-progress"></div>

  <div class="app-layout">
    <!-- ── Sidebar ── -->
    <aside class="sidebar">
      <div class="sidebar-logo">
        <div class="sidebar-logo-icon">⚡</div>
        <span class="sidebar-logo-text">PulseBoard</span>
      </div>

      <nav class="sidebar-nav">
        <p class="sidebar-section-label">Navigation</p>
        <a href="/" class="sidebar-link <%= (typeof currentPage !== 'undefined' && currentPage === 'dashboard') ? 'active' : '' %>">
          <span class="icon">🏠</span> Dashboard
        </a>
        <a href="/activity" class="sidebar-link <%= (typeof currentPage !== 'undefined' && currentPage === 'activity') ? 'active' : '' %>">
          <span class="icon">📋</span> Activity Feed
        </a>

        <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <p class="sidebar-section-label" style="margin-top: var(--space-4);">Projects</p>
        <% projects.forEach(p => { %>
          <a href="/projects/<%= p.id %>" class="sidebar-link <%= (typeof currentProject !== 'undefined' && currentProject && currentProject.id === p.id) ? 'active' : '' %>">
            <span class="icon">📁</span>
            <span class="truncate"><%= p.name %></span>
          </a>
        <% }) %>
        <% } %>
      </nav>

      <div class="sidebar-footer">
        <button
          class="sidebar-new-project-btn"
          hx-get="/projects/new"
          hx-target="#modal-container"
          hx-swap="innerHTML"
        >
          <span>＋</span> New Project
        </button>
      </div>
    </aside>

    <!-- ── Main Content ── -->
    <div class="main-content">
      <%- body %>
    </div>
  </div>

  <!-- ── Modal Container (HTMX target) ── -->
  <div id="modal-container"></div>

  <!-- ── Mobile Bottom Navigation ── -->
  <nav class="mobile-bottom-nav" id="mobile-bottom-nav">

    <!-- Dashboard -->
    <a href="/"
       class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'dashboard') ? 'active' : '' %>"
       id="mobile-nav-dashboard">
      <span class="mobile-nav-icon">🏠</span>
      <span class="mobile-nav-label">Home</span>
    </a>

    <!-- Projects sheet toggle -->
    <button class="mobile-nav-item" id="mobile-nav-projects-btn" onclick="toggleProjectsSheet()" type="button">
      <span class="mobile-nav-icon">📁</span>
      <span class="mobile-nav-label">Projects</span>
    </button>

    <!-- New Project -->
    <button
      class="mobile-nav-item mobile-nav-add"
      id="mobile-nav-new-project"
      hx-get="/projects/new"
      hx-target="#modal-container"
      hx-swap="innerHTML"
      type="button"
    >
      <span class="mobile-nav-add-icon">＋</span>
      <span class="mobile-nav-label">New Project</span>
    </button>

    <!-- New Task -->
    <button
      class="mobile-nav-item"
      id="mobile-nav-new-task"
      hx-get="/tasks/new"
      hx-target="#modal-container"
      hx-swap="innerHTML"
      type="button"
    >
      <span class="mobile-nav-icon">✏️</span>
      <span class="mobile-nav-label">New Task</span>
    </button>

    <!-- Activity Feed -->
    <a href="/activity"
       class="mobile-nav-item <%= (typeof currentPage !== 'undefined' && currentPage === 'activity') ? 'active' : '' %>"
       id="mobile-nav-activity">
      <span class="mobile-nav-icon">📋</span>
      <span class="mobile-nav-label">Activity</span>
    </a>

  </nav>

  <!-- ── Mobile Projects Sheet ── -->
  <div class="mobile-projects-backdrop" id="mobile-projects-backdrop" onclick="toggleProjectsSheet()"></div>
  <div class="mobile-projects-sheet" id="mobile-projects-sheet">
    <div class="mobile-sheet-handle"></div>
    <div class="mobile-sheet-header">
      <span class="mobile-sheet-title">📁 Projects</span>
      <button class="mobile-sheet-close" onclick="toggleProjectsSheet()" type="button">✕</button>
    </div>
    <nav class="mobile-sheet-nav">
      <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <% projects.forEach(p => { %>
          <a href="/projects/<%= p.id %>"
             class="mobile-sheet-link <%= (typeof currentProject !== 'undefined' && currentProject && currentProject.id === p.id) ? 'active' : '' %>"
             onclick="toggleProjectsSheet()">
            <span class="mobile-sheet-link-icon">📁</span>
            <span class="truncate"><%= p.name %></span>
          </a>
        <% }) %>
      <% } else { %>
        <p class="mobile-sheet-empty">No projects yet.<br>Tap <strong>New Project</strong> to create one.</p>
      <% } %>
    </nav>
    <div class="mobile-sheet-footer">
      <button
        class="btn btn-primary w-full"
        hx-get="/projects/new"
        hx-target="#modal-container"
        hx-swap="innerHTML"
        onclick="toggleProjectsSheet()"
        type="button"
      >＋ New Project</button>
    </div>
  </div>

  <script>
    // HTMX progress bar
    document.addEventListener('htmx:beforeRequest', () => {
      document.getElementById('htmx-progress').style.width = '30%';
      document.getElementById('htmx-progress').style.display = 'block';
    });
    document.addEventListener('htmx:afterRequest', () => {
      const bar = document.getElementById('htmx-progress');
      bar.style.width = '100%';
      setTimeout(() => {
        bar.style.display = 'none';
        bar.style.width = '0%';
      }, 300);
    });

    // Close modal on backdrop click
    document.addEventListener('click', (e) => {
      if (e.target.classList.contains('form-overlay')) {
        document.getElementById('modal-container').innerHTML = '';
      }
    });

    // Close modal on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.getElementById('modal-container').innerHTML = '';
        closeProjectsSheet();
      }
    });

    // Update status select data attribute for CSS styling
    document.addEventListener('htmx:afterSwap', () => {
      document.querySelectorAll('.task-status-select').forEach(sel => {
        sel.dataset.status = sel.value;
      });
    });
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('task-status-select')) {
        e.target.dataset.status = e.target.value;
      }
    });

    // Mobile Projects Sheet
    function toggleProjectsSheet() {
      const sheet = document.getElementById('mobile-projects-sheet');
      const backdrop = document.getElementById('mobile-projects-backdrop');
      const btn = document.getElementById('mobile-nav-projects-btn');
      const isOpen = sheet.classList.contains('open');
      if (isOpen) {
        sheet.classList.remove('open');
        backdrop.classList.remove('open');
        btn.classList.remove('active');
      } else {
        sheet.classList.add('open');
        backdrop.classList.add('open');
        btn.classList.add('active');
      }
    }
    function closeProjectsSheet() {
      document.getElementById('mobile-projects-sheet').classList.remove('open');
      document.getElementById('mobile-projects-backdrop').classList.remove('open');
      document.getElementById('mobile-nav-projects-btn').classList.remove('active');
    }
  </script>
</body>
</html>
