{
  "name": "pulseboard",
  "version": "1.0.0",
  "description": "A polished HTMX-powered task and activity board built with Node.js, Express, EJS, and SQLite",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "nodemon --exec \"node --experimental-sqlite\" src/server.js",
    "seed": "node --experimental-sqlite src/db/seed.js",
    "init-db": "node --experimental-sqlite src/db/init.js"
  },
  "keywords": ["htmx", "express", "sqlite", "task-management", "productivity"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "method-override": "^3.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
